# Folder the agents may touch. Every repo the team works on lives directly inside it.
# Defaults to the parent of ai-team/ (i.e. ~/github). ai-team/ itself is always off-limits.
AI_TEAM_WORKSPACE_ROOT=/home/creator-base/github

# LLM provider: mock | anthropic | openai | ollama
#   mock = no LLM calls; deterministic fake agents, for exercising the pipeline/dashboard.
AI_TEAM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model per tier. Triage picks a tier per task; agents use it.
AI_TEAM_MODEL_FAST=claude-haiku-4-5-20251001
AI_TEAM_MODEL_BALANCED=claude-sonnet-5-5
AI_TEAM_MODEL_DEEP=claude-opus-5-5
# Model used for triage (classifying incoming tasks)
AI_TEAM_MODEL_TRIAGE=claude-haiku-4-5-20251001

# Orchestrator
# tasks worked on at once
AI_TEAM_MAX_PARALLEL=1
# coder <-> reviewer iterations before giving up
AI_TEAM_MAX_REVIEW_ROUNDS=2
# tool-call budget per agent run
AI_TEAM_AGENT_MAX_STEPS=40
# seconds, for run_command tool
AI_TEAM_COMMAND_TIMEOUT=120
